session_start();
require_once '../config/database.php';
require_once 'reports_engine.php';

// Auth check
if (!isset($_SESSION['admin_logged_in']) || $_SESSION['admin_logged_in'] !== true) {
    header('Location: login.php');
    exit;
}

$database = new Database();
$db = $database->getConnection();
$reports = new ReportsEngine($db);

// Handle AJAX requests
if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['action'])) {
    header('Content-Type: application/json');
    
    switch ($_POST['action']) {
        case 'generate_report':
            $report_type = $_POST['report_type'];
            $filters = $_POST['filters'] ?? [];
            $export_format = $_POST['export_format'] ?? 'view';
            
            try {
                $data = [];
                $title = '';
                
                switch ($report_type) {
                    case 'sales':
                        $result = $reports->getSalesReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير المبيعات';
                        break;
                        
                    case 'returns':
                        $result = $reports->getReturnsReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير المرتجعات';
                        break;
                        
                    case 'inventory':
                        $result = $reports->getInventoryReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير المخزون';
                        break;
                        
                    case 'appointments':
                        $result = $reports->getAppointmentsReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير المواعيد';
                        break;
                        
                    case 'customers':
                        $result = $reports->getCustomersReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير العملاء';
                        break;
                        
                    case 'hr':
                        $result = $reports->getHRReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير الموارد البشرية';
                        break;
                        
                    case 'shifts':
                        $result = $reports->getShiftsReport($filters);
                        $data = $result['data'];
                        $summary = $result['summary'];
                        $title = 'تقرير الورديات';
                        break;
                }
                
                if ($export_format === 'csv') {
                    $reports->exportToCSV($data, $title . '_' . date('Y-m-d'));
                } elseif ($export_format === 'pdf') {
                    $html = $reports->generatePDF($data, $title, $summary);
                    echo json_encode(['success' => true, 'html' => $html]);
                } else {
                    echo json_encode(['success' => true, 'data' => $data, 'summary' => $summary]);
                }
                
            } catch (Exception $e) {
                echo json_encode(['success' => false, 'error' => $e->getMessage()]);
            }
            exit;
    }
}

// Get filter options
$services_stmt = $db->query("SELECT id, title_ar FROM services ORDER BY title_ar");
$services = $services_stmt->fetchAll(PDO::FETCH_ASSOC);

$specialists_stmt = $db->query("SELECT id, name_ar FROM team_members WHERE position_ar LIKE '%أخصائي%' ORDER BY name_ar");
$specialists = $specialists_stmt->fetchAll(PDO::FETCH_ASSOC);

$employees_stmt = $db->query("SELECT id, name_ar FROM team_members ORDER BY name_ar");
$employees = $employees_stmt->fetchAll(PDO::FETCH_ASSOC);


// Layout configuration
$page_title = 'التقارير';
$page_subtitle = 'إدارة وعرض البيانات';
$page_actions = '';

// Get current admin info
$admin = [
    'id' => $_SESSION['admin_id'] ?? 1,
    'username' => $_SESSION['admin_username'] ?? 'admin'
];

