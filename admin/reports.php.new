    <script>
        let currentReportType = '';

        function openReportModal(reportType) {
            currentReportType = reportType;
            document.getElementById('reportModal').classList.remove('hidden');
            document.getElementById('reportModal').classList.add('flex');
            
            // Set report title
            const titles = {
                'sales': 'تقرير المبيعات',
                'returns': 'تقرير المرتجعات',
                'inventory': 'تقرير المخزون',
                'appointments': 'تقرير المواعيد',
                'customers': 'تقرير العملاء',
                'hr': 'تقرير الموارد البشرية',
                'shifts': 'تقرير الورديات'
            };
            document.getElementById('reportTitle').textContent = titles[reportType];
            
            // Show/hide relevant filters
            hideAllFilters();
            showFiltersForReport(reportType);
            
            // Set default date range (last 30 days)
            const today = new Date();
            const lastMonth = new Date(today.getTime() - (30 * 24 * 60 * 60 * 1000));
            document.querySelector('input[name="date_to"]').value = today.toISOString().split('T')[0];
            document.querySelector('input[name="date_from"]').value = lastMonth.toISOString().split('T')[0];
        }

        function closeReportModal() {
            document.getElementById('reportModal').classList.add('hidden');
            document.getElementById('reportModal').classList.remove('flex');
            document.getElementById('reportContent').innerHTML = `
                <div class="text-center text-gray-500 py-8">
                    <i class="fas fa-chart-bar text-4xl mb-4"></i>
                    <p>اختر الفلاتر واضغط "عرض التقرير" لبدء التحليل</p>
                </div>
            `;
        }

        function hideAllFilters() {
            const filters = ['paymentMethodFilter', 'serviceFilter', 'specialistFilter', 'employeeFilter', 
                           'categoryFilter', 'lowStockFilter', 'loyaltyFilter', 'spendingFilter'];
            filters.forEach(filter => {
                document.getElementById(filter).classList.add('hidden');
            });
        }

        function showFiltersForReport(reportType) {
            switch(reportType) {
                case 'sales':
                    document.getElementById('paymentMethodFilter').classList.remove('hidden');
                    document.getElementById('serviceFilter').classList.remove('hidden');
                    document.getElementById('specialistFilter').classList.remove('hidden');
                    break;
                case 'appointments':
                    document.getElementById('specialistFilter').classList.remove('hidden');
                    break;
                case 'inventory':
                    document.getElementById('categoryFilter').classList.remove('hidden');
                    document.getElementById('lowStockFilter').classList.remove('hidden');
                    break;
                case 'customers':
                    document.getElementById('loyaltyFilter').classList.remove('hidden');
                    document.getElementById('spendingFilter').classList.remove('hidden');
                    break;
                case 'hr':
                    document.getElementById('employeeFilter').classList.remove('hidden');
                    break;
            }
        }

        function generateReport(format) {
            const formData = new FormData(document.getElementById('reportFilters'));
            formData.append('action', 'generate_report');
            formData.append('report_type', currentReportType);
            formData.append('export_format', format);

            if (format === 'csv') {
                // For CSV export, submit form directly
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = 'reports.php';
                
                for (let [key, value] of formData.entries()) {
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = key;
                    input.value = value;
                    form.appendChild(input);
                }
                
                document.body.appendChild(form);
                form.submit();
                document.body.removeChild(form);
                return;
            }

            fetch('reports.php', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    if (format === 'pdf') {
                        // Open PDF in new window
                        const newWindow = window.open();
                        newWindow.document.write(data.html);
                        newWindow.document.close();
                    } else {
                        // Display report data
                        displayReportData(data.data, data.summary);
                    }
                } else {
                    alert('خطأ في إنشاء التقرير: ' + data.error);
                }
            })
            .catch(error => {
                alert('حدث خطأ في الاتصال');
            });
        }

        function displayReportData(data, summary) {
            let html = '';
            
            // Summary section
            if (summary) {
                html += '<div class="bg-blue-50 rounded-lg p-4 mb-6"><h4 class="font-semibold text-gray-900 mb-3">ملخص التقرير</h4>';
                for (let [key, value] of Object.entries(summary)) {
                    html += `<div class="flex justify-between py-1"><span>${key}:</span><span class="font-medium">${value}</span></div>`;
                }
                html += '</div>';
            }
            
            // Data table
            if (data && data.length > 0) {
                html += '<div class="overflow-x-auto"><table class="w-full border-collapse border border-gray-300">';
                html += '<thead class="bg-gray-50"><tr>';
                
                // Headers
                for (let key of Object.keys(data[0])) {
                    html += `<th class="border border-gray-300 px-4 py-2 text-right">${key}</th>`;
                }
                html += '</tr></thead><tbody>';
                
                // Data rows
                for (let row of data) {
                    html += '<tr class="hover:bg-gray-50">';
                    for (let value of Object.values(row)) {
                        html += `<td class="border border-gray-300 px-4 py-2">${value || '-'}</td>`;
                    }
                    html += '</tr>';
                }
                html += '</tbody></table></div>';
            } else {
                html += '<div class="text-center text-gray-500 py-8"><p>لا توجد بيانات للعرض</p></div>';
            }
            
            document.getElementById('reportContent').innerHTML = html;
        }
    </script>


